# --- LLM ---
LLM=gemini
GEMINI_API_KEY=pon_aqui_tu_key_de_ai_studio
# Modelo de generacion. gemini-3.6-flash es el Flash vigente y gratuito (jul 2026).
# Si Google lo renombra, usa el nombre actual del pricing de AI Studio.
GEMINI_MODEL=gemini-3.6-flash

# --- Embeddings ---
# local  = sentence-transformers en CPU, sin API key ni cuota (requiere ~500MB de torch)
# gemini = API de Google, sin descarga pesada, ideal para VMs chicas
EMBEDDER=gemini
# Modelo de embeddings de Gemini (vigente jul 2026).
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Vector store ---
VECTOR_STORE=numpy
TOP_K=5

# --- Troceado ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
