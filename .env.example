# ============================================================
#  LUMORA — configuración
# ============================================================

# --- Modo de LLM ---
# echo      = sin red, para probar el cableado sin gastar cuota
# gemini    = solo Google Gemini
# groq      = solo Groq (Llama, muy rápido, buena cuota gratis)
# cerebras  = solo Cerebras
# fallback  = CASCADA: prueba varios en orden; si uno se agota, salta al siguiente
LLM=fallback

# Orden de la cascada (solo se usan los que tengan su API key configurada abajo)
LLM_FALLBACK_ORDER=gemini,groq,cerebras

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=pon_aqui_tu_key
# Flash-Lite tiene mejor cuota gratis (30 RPM / ~1500 RPD) que los modelos preview.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Groq (console.groq.com — gratis, sin tarjeta) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cerebras (cloud.cerebras.ai — gratis, sin tarjeta) ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# --- Embeddings ---
# Los embeddings siguen usando Gemini (necesita GEMINI_API_KEY).
EMBEDDER=gemini

# --- Vector store ---
VECTOR_STORE=numpy
TOP_K=5

# --- Troceado ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
